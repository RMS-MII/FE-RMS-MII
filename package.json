{
  "name": "RMS-MII",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build:internal": "turbo --filter @rms/internal build",
    "dev:internal": "turbo --filter @rms/internal dev",
    "build:exam": "turbo --filter @rms/exam build",
    "dev:exam": "turbo --filter @rms/exam dev",
    "build:candidate": "turbo --filter @rms/candidate build",
    "dev:candidate": "turbo --filter @rms/candidate dev",
    "e2e:build-api": "dotnet build ../BE-RMS-MII/WEBAPI/WEBAPI.csproj --configuration E2E -p:UseAppHost=false",
    "e2e:db": "node scripts/e2e/prepare-db.mjs",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "lint": "turbo lint",
    "format": "turbo format",
    "typecheck": "turbo typecheck"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2.11.10",
    "typescript": "~6.0.2"
  },
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=20.19.0"
  }
}
