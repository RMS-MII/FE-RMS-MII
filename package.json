{
  "name": "RMS-MII",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "start": "turbo run start",
    "build:internal": "turbo --filter @rms/internal build",
    "dev:internal": "turbo --filter @rms/internal dev",
    "start:internal": "turbo --filter @rms/internal start",
    "build:exam": "turbo --filter @rms/exam build",
    "dev:exam": "turbo --filter @rms/exam dev",
    "start:exam": "turbo --filter @rms/exam start",
    "build:candidate": "turbo --filter @rms/candidate build",
    "dev:candidate": "turbo --filter @rms/candidate dev",
    "start:candidate": "turbo --filter @rms/candidate start",
    "lint": "turbo lint",
    "format": "turbo format",
    "typecheck": "turbo typecheck"
  },
  "devDependencies": {
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2.11.10",
    "typescript": "~6.0.2"
  },
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=20.19.0"
  }
}
